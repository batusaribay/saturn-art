#!/bin/bash
# Omarchy screensaver launcher: saturn-art instead of the stock text effect.
#
# Omarchy's idle service runs `omarchy-launch-screensaver` through a login
# shell, and this shim comes first in the login PATH.  It opens one
# fullscreen terminal per monitor on the usual screensaver special workspace,
# running saturn-art in its screensaver mode (any input dismisses it).  The
# terminal keeps its normal profile: only the class marks it as a screensaver.

pgrep -f '[o]rg.omarchy.screensaver' >/dev/null && exit 0

# Respect `omarchy toggle screensaver off`; `force` bypasses it just like the
# stock launcher.
if omarchy-toggle-enabled screensaver-off 2>/dev/null && [[ ${1:-} != force ]]; then
  exit 1
fi

saturn_bin=$(command -v saturn-art) || exit 1
focused=$(omarchy-hyprland-monitor-focused 2>/dev/null)
terminal=$(xdg-terminal-exec --print-id 2>/dev/null)

case $terminal in
*Alacritty* | *ghostty* | *foot* | *kitty*) ;;
*)
  omarchy-notification-send -g ✋ "Screensaver only runs in Alacritty, Foot, Ghostty, or Kitty"
  exit 1
  ;;
esac

hypr_focus_monitor() {
  hyprctl dispatch "hl.dsp.focus({ monitor = \"$1\" })" >/dev/null 2>&1 ||
    hyprctl dispatch focusmonitor "$1" >/dev/null 2>&1
}

hide_cursor() {
  hyprctl eval 'hl.config({ cursor = { invisible = true } })' >/dev/null 2>&1 ||
    hyprctl keyword cursor:invisible true >/dev/null 2>&1 || true
}

show_cursor() {
  hyprctl eval 'hl.config({ cursor = { invisible = false } })' >/dev/null 2>&1 ||
    hyprctl keyword cursor:invisible false >/dev/null 2>&1 || true
}

# Launch a command on this monitor's screensaver special workspace.  Hyprland
# 0.56 takes commands through its Lua dispatcher.
hypr_exec() {
  local command
  printf -v command '%q ' "$@"
  hyprctl dispatch "hl.dsp.exec_cmd([[[workspace $workspace] $command]])" >/dev/null 2>&1 ||
    hyprctl dispatch exec -- "[workspace $workspace]" bash -lc "$command" >/dev/null 2>&1
}

hide_cursor

for m in $(hyprctl monitors -j | jq -r '.[].name'); do
  hypr_focus_monitor "$m"
  workspace="special:screensaver-$m"
  # Deliberately no --config/--font-size: saturn-art should look like it does
  # in a normal window, so it inherits the terminal's own font, padding and
  # theme.  Hyprland's rules fullscreen the screensaver class anyway.
  case $terminal in
  *Alacritty*)
    hypr_exec alacritty --class=org.omarchy.screensaver -e "$saturn_bin" --screensaver
    ;;
  *ghostty*)
    hypr_exec ghostty --class=org.omarchy.screensaver -e "$saturn_bin" --screensaver
    ;;
  *foot*)
    hypr_exec foot --app-id=org.omarchy.screensaver -e "$saturn_bin" --screensaver
    ;;
  *kitty*)
    hypr_exec kitty --class=org.omarchy.screensaver -e "$saturn_bin" --screensaver
    ;;
  esac
  sleep 0.1
done

[ -n "$focused" ] && hypr_focus_monitor "$focused"

# Put the pointer back as soon as the last saturn-art window is gone.  The
# class travels through the environment so this script does not match itself.
(
  while hyprctl clients -j 2>/dev/null |
    SCREENSAVER=org.omarchy.screensaver jq -e 'any(.[]; .mapped and .class == env.SCREENSAVER)' >/dev/null 2>&1; do
    sleep 0.2
  done
  show_cursor
) >/dev/null 2>&1 &
